# The backend reads only prepared runtime observations. Never add evaluation labels here.
RUNTIME_DATA_DIR=data/runtime
CORS_ORIGINS=http://localhost:8501,http://localhost:5173
DEPLOYMENT_ENV=local-research

# Stateful API protection. Set this on any public deployment and provide the
# same value to the server-side Streamlit/React host as BACKEND_API_TOKEN.
# Never expose this token in browser JavaScript or commit it to Git.
API_AUTH_TOKEN=

# Durable storage for Lambda/API Gateway. Leave empty for local in-memory tests.
INVESTIGATION_DDB_TABLE=
# Continuum Case aggregate storage. Required for a public durable deployment.
CASE_DDB_TABLE=
LLM_JOB_QUEUE_NAME=mfg-investigation-narrative-jobs
# Set by the AWS deployment output; do not expose this in browser-side code.
LLM_JOB_QUEUE_URL=

ACTOR_CONTEXT_REQUIRED=false
# Public deployments can require a trusted gateway to inject these headers.
# The current shared bearer token is not a user identity provider.
ACTOR_ID_HEADER=X-Actor-Id
ACTOR_ROLE_HEADER=X-Actor-Role

# Optional: pinned upstream causRCA checkout used for deterministic CausTR ranking.
# Created locally by `python scripts/bootstrap_causrca.py`.
CAUSRCA_UPSTREAM_DIR=third_party/causRCA

# Optional LLM integration. Keep secrets out of Git and browser code.
# Direct AWS Bedrock remains the default for backward compatibility.
# LLM_PROVIDER=direct_bedrock

# Competition gateway: OpenAI-compatible access to the provided Bedrock aliases.
# Install the runtime extra first: pip install -e '.[llm]'
# LLM_PROVIDER=competition_gateway
# LLM_BASE_URL=https://52.79.201.46/v1
# LLM_MODEL=bedrock-haiku
# LLM_API_KEY=

# Bedrock narrative/chat configuration. Guardrails are independent API checks
# around both model input and output when the ID is configured.
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# LLM_TIMEOUT_S=8
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
# BEDROCK_MODEL_ARN=
# BEDROCK_GUARDRAIL_ARN=
# LLM_REQUIRE_GUARDRAIL=false
