{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "bedrock.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "430013477501" },
        "ArnLike": { "aws:SourceArn": "arn:aws:bedrock:us-east-1:430013477501:agent/*" }
      }
    }
  ]
}
