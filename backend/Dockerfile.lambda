# AWS Lambda container image for the FastAPI investigation API (task #17).
# Build context MUST be the repository root:
#   docker build -f backend/Dockerfile.lambda -t mfg-investigation-api .
FROM public.ecr.aws/lambda/python:3.12

WORKDIR ${LAMBDA_TASK_ROOT}

COPY backend/app ./app
COPY backend/lambda_handler.py ./lambda_handler.py
COPY backend/llm_job_handler.py ./llm_job_handler.py

# Metal Etch uses a lightweight PCA path in the request. Install its runtime
# dependencies so the API does not report a dataset as ready while silently
# disabling the advertised analysis. CausTR remains an optional pinned upstream
# dependency because its torch/scikit-network stack is too large for this lean
# Lambda image; the API exposes that fallback explicitly in warnings.
RUN pip install --no-cache-dir \
    "fastapi>=0.115,<1" \
    "pydantic>=2.10,<3" \
    "langgraph>=0.4,<1" \
    "mangum>=0.19,<1" \
    "anthropic>=0.40" \
    "openai>=1.66,<2" \
    "numpy>=1.26,<3" \
    "scipy>=1.14,<2" \
    "scikit-learn>=1.5,<2"

# Prepared runtime data is baked into the image read-only, since Lambda's
# writable /tmp is ephemeral and this is a read-only investigation API.
COPY data/runtime ./data/runtime
ENV RUNTIME_DATA_DIR=/var/task/data/runtime

CMD ["lambda_handler.handler"]
